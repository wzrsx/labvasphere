  "guide": {
    "header": {
      "title": "User Guide",
      "subtitle": "Simple guide: how to upload and showcase your 360° panoramas to clients"
    },
    "tabs": {
      "prepare": "Preparation",
      "upload": "Upload",
      "view": "Viewing",
      "share": "Share",
      "faq": "FAQ"
    },
    "prepare": {
      "title": "📸 How to Prepare a Panorama",
      "step1": {
        "title": "Take the Panorama",
        "desc": "Use a 360° camera or smartphone with panorama mode. Shoot in a well-lit room, without people in the frame."
      },
      "step2": {
        "title": "Check the Format",
        "desc": "The file should be rectangular (2:1 aspect ratio), in JPG, PNG, TIFF, or WEBP format. If unsure — just upload, the system will guide you."
      },
      "step3": {
        "title": "Edit if Needed",
        "desc": "Remove the tripod from the frame, level the horizon. You can use simple editors: Canva, Photopea, or built-in platform tools."
      },
      "tip": {
        "icon": "💡",
        "label": "Tip:",
        "text": "Shoot at the same time of day so all project panoramas have consistent lighting."
      }
    },
    "upload": {
      "title": "📤 How to Upload a Project",
      "step1": {
        "title": "Create a Project",
        "desc": "Click \"+ New Project\" and enter a name (e.g., \"Apartment on Krasnoprudnaya\")."
      },
      "step2": {
        "title": "Add a Description",
        "desc": "Specify the room name, materials, features. This helps clients better understand your project."
      },
      "step3": {
        "title": "Upload Panoramas",
        "desc": "Drag files into the upload window or click \"Select Files\". You can upload multiple panoramas at once."
      },
      "step4": {
        "title": "Choose a Cover Angle",
        "desc": "View the panorama and pick the best angle — this is the first thing clients will see. Position the camera to highlight the interior's main advantage."
      },
      "step5": {
        "title": "Save and Publish",
        "desc": "Click \"Create Project\" — the panorama will be automatically processed and become available for viewing (only to you)."
      },
      "tip": {
        "icon": "⏱️",
        "label": "Processing Time:",
        "text": "Usually 1-3 minutes. Large files (over 10 MB) may take longer."
      }
    },
    "view": {
      "title": "👁️ How to View and Adjust a Panorama",
      "step1": {
        "title": "Navigation Controls",
        "desc": "• Mouse: hold left button and drag to rotate.<br/>• Touchscreen: swipe with your finger.<br/>• Scroll wheel: zoom in/out."
      },
      "step2": {
        "title": "Interactive Hotspots",
        "desc": "Click on hotspots in the panorama to navigate, view information about materials, furniture, or links to floor plans."
      },
      "step3": {
        "title": "Fullscreen Mode",
        "desc": "Click the icon in the bottom-right corner or press F to immerse in the project. Exit with Esc or click again."
      },
      "step4": {
        "title": "Auto-Rotate (Optional)",
        "desc": "Click \"Auto-Rotate\" to let the panorama spin smoothly. Great for presentations."
      },
      "tip": {
        "icon": "📱",
        "label": "On Smartphone:",
        "text": "you can view the panorama by simply rotating your device — enable gyroscope mode in viewing settings."
      }
    },
    "share": {
      "title": "🔗 How to Share a Project with a Client",
      "link": {
        "title": "📋 Link",
        "desc": "Copy the unique link from the project card and send it to your client via messenger, email, or social media.",
        "benefits": [
          "Works on any device",
          "No registration required for the client"
        ]
      },
      "qr": {
        "title": "🧾 QR Code",
        "desc": "Download the project's QR code and add it to a presentation, business card, or printed brochure.",
        "benefits": [
          "Client scans with camera — and lands directly in the panorama",
          "Perfect for offline meetings"
        ]
      }
    },
    "faq": {
      "title": "❓ Frequently Asked Questions",
      "table": {
        "headers": ["Question", "Answer"],
        "rows": [
          {
            "q": "Which cameras are compatible?",
            "a": "Any 360° cameras (Insta360, Ricoh Theta) and smartphones with panorama mode. The key is a 2:1 final image."
          },
          {
            "q": "Can I upload multiple rooms?",
            "a": "Yes! Create one project and add all panoramas to it. Clients can switch between them."
          },
          {
            "q": "Client can't see the panorama — what to do?",
            "a": "Check if link access is enabled. Ensure the client uses a modern browser (Chrome, Safari, Firefox)."
          },
          {
            "q": "How do I update a panorama?",
            "a": "Go to the project → \"Edit\" → upload a new file instead of the old one. The old version will be replaced automatically."
          },
          {
            "q": "Can I download the panorama back?",
            "a": "Yes, in project settings there's an \"Export Source\" button (available in Pro plan)."
          }
        ]
      }
    },
    "footer": {
      "text": "Still have questions?",
      "link": "Contact Support",
      "time": "— we'll help within 15 minutes."
    }
  },
  "lang_btn": "🇬🇧 EN"
}